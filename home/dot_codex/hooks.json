{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/lint-reply.sh",
            "timeout": 10,
            "statusMessage": "Linting reply voice"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|shell|exec_command|local_shell",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/inject-code-rules.py",
            "timeout": 10,
            "statusMessage": "Loading coding rules"
          }
        ]
      }
    ]
  }
}
