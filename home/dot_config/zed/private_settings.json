// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "auto_install_extensions": {
    "astro": true,
    "catppuccin-icons": true,
    "dockerfile": true,
    "git-firefly": true,
    "glsl": true,
    "html": true,
    "proto": true,
    "rose-pine-theme": true,
    "terraform": true,
    "toml": true
  },
  "markdown_preview_font_size": 17.0,
  "agent_buffer_font_size": 16.0,
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "agent_ui_font_size": 17.0,
  "sticky_scroll": {
    "enabled": true
  },
  "cli_default_open_behavior": "new_window",
  "debugger": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "fast": true,
        "model": "claude-fable-5-1[1m]",
        "effort": "max",
        "mode": "auto"
      },
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-6-astra",
        "collaboration_mode": "default",
        "reasoning_effort": "ultra",
        "mode": "agent-full-access",
        "fast-mode": true
      },
      "type": "registry"
    }
  },
  "excerpt_context_lines": 8,
  "agent": {
    "thinking_display": "preview",
    "show_turn_stats": true,
    "use_modifier_to_send": false,
    "sidebar_side": "right",
    "dock": "right",
    "default_profile": "ask",
    "default_model": {
      "effort": "medium",
      "provider": "openai-subscribed",
      "model": "gpt-5.5",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "expand_excerpt_lines": 8,

  // Keymaps configuration
	"base_keymap": "VSCode",
	"vim_mode": true,

	// UI configuration
	"icon_theme": "Catppuccin Frappé",
	"ui_font_size": 17.0,
	"buffer_font_size": 17.0,
	"tab_size": 2,
	"hard_tabs": false,
	"theme": {
		"mode": "system",
		"light": "Rosé Pine Dawn",
		"dark": "Rosé Pine Moon"
	},

	// Terminal configuration
	"terminal": {
		"font_size": 17.0,
  "dock": "bottom",
  "shell": {
			"program": "fish"
		}
	},

	// Biome configuration
	"lsp": {
		"biome": {
			"settings": {
				"require_config_file": true
			}
		},
		"vtsls": {
			"settings": {
				"javascript": {
     "updateImportsOnFileMove": {
      "enabled": "always"
     }
    },
    "typescript": {
					"updateImportsOnFileMove": {
      "enabled": "always"
     },
     "preferences": {
						"importModuleSpecifier": "non-relative"
					}
				}
			}
		}
	},
	"languages": {
		"JavaScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TypeScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TSX": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"JSON": { "formatter": { "language_server": { "name": "biome" } } },
		"JSONC": { "formatter": { "language_server": { "name": "biome" } } },
		"CSS": { "formatter": { "language_server": { "name": "biome" } } },
		"GraphQL": { "formatter": { "language_server": { "name": "biome" } } }
  },
  "context_servers": {

  },
  "confirm_quit": true
}
