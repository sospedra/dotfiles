#!/bin/sh
# tool-versions hash: {{ include "dot_tool-versions" | sha256sum }}
set -eu
eval "$(/opt/homebrew/bin/brew shellenv)"
cd "$HOME"
installed=$(asdf plugin list 2>/dev/null || true)
awk '!/^#/ && NF {print $1}' "$HOME/.tool-versions" | while read -r plugin; do
  echo "$installed" | grep -qx "$plugin" || asdf plugin add "$plugin"
done
asdf install
